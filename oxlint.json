{
  "$schema": "https://raw.githubusercontent.com/nicolo-ribaudo/oxlint-config-inspector/refs/heads/main/oxlintrc.schema.json",
  "rules": {
    "no-unused-vars": "warn",
    "no-console": "warn",
    "eqeqeq": "error",
    "no-var": "error",
    "prefer-const": "warn"
  },
  "ignorePatterns": ["node_modules", ".next", "out"]
}
